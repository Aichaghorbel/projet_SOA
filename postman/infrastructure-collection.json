
{
  "info": {
    "name": "SOA Microservices Project",
    "description": "Postman collection for testing the SOA microservices infrastructure.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "studentsUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "coursesUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "enrollmentsUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "jaegerUrl",
      "value": "http://localhost:16686"
    }
  ],
  "item": [
    {
      "name": "Students Service",
      "item": [
        {
          "name": "Get Students",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{studentsUrl}}/api/students"
          }
        }
      ]
    },
    {
      "name": "Courses Service",
      "item": [
        {
          "name": "Get Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{coursesUrl}}/api/courses"
          }
        }
      ]
    },
    {
      "name": "Enrollments Service",
      "item": [
        {
          "name": "Get Enrollments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{enrollmentsUrl}}/api/enrollments"
          }
        }
      ]
    },
    {
      "name": "Infrastructure",
      "item": [
        {
          "name": "Jaeger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{jaegerUrl}}"
          }
        }
      ]
    }
  ]
}
